{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["vite/client"],
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../../types/vite-env.d.ts",
    "../../services/api/**/*.ts",
    "../../util/**/*.ts",
    "../../validation/**/*.ts",
  ],
  "exclude": []
}
