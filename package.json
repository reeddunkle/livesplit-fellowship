{
  "name": "livesplit-fellowship",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "check": "run-s lint test typecheck knip",
    "cli": "tsx src/cli/cli.ts",
    "cli:livesplit": "tsx src/cli/live-split-cli.ts",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "knip": "knip",
    "test:replay-log-file": "tsx src/scripts/replay-log-file.ts",
    "test:watch": "vitest",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "pnpm@11.22.0",
  "dependencies": {
    "@effect/platform-node": "catalog:effect",
    "dotenv": "catalog:runtime",
    "effect": "catalog:effect"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:biome",
    "@effect/language-service": "catalog:effect",
    "@types/node": "catalog:node",
    "knip": "catalog:tooling",
    "npm-run-all2": "catalog:tooling",
    "tsx": "catalog:typescript",
    "typescript": "catalog:typescript",
    "vitest": "catalog:testing"
  }
}
